            <Comment TxtId=""><![CDATA[负载侧(对拖 CST)使能: 0=不接负载, 1=使能 4 个负载轴。可在运行中改]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-000000000002}">USINT</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>LoadTorquePct0</Name>
            <Comment TxtId=""><![CDATA[负载轴0 目标转矩 [0.1% 额定], 1000=100%。仅送纸凸轮实验生效]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>LoadTorquePct1</Name>
            <Comment TxtId=""><![CDATA[负载轴1 目标转矩 [0.1% 额定], 1000=100%]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>LoadTorquePct2</Name>
            <Comment TxtId=""><![CDATA[负载轴2 目标转矩 [0.1% 额定], 1000=100%]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>LoadTorquePct3</Name>
            <Comment TxtId=""><![CDATA[负载轴3 目标转矩 [0.1% 额定], 1000=100%]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>bLiveTuning</Name>
            <Comment TxtId=""><![CDATA[在线调参总开关: 0=用编译期默认(安全), 1=用下面5项]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-000000000002}">USINT</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>VelFfGain</Name>
            <Comment TxtId=""><![CDATA[速度前馈增益 0~1.2 (60B1h), 1.0=满量]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>VelFfAccGainMs</Name>
            <Comment TxtId=""><![CDATA[速度前馈加速度项 Ka [ms], 方案B, 0=关闭(扫参3~15)]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>LeadAccMs2</Name>
            <Comment TxtId=""><![CDATA[位置二阶超前 K [ms²], 0=关闭(扫参30~60)]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>MaxFollowErrMm</Name>
            <Comment TxtId=""><![CDATA[跟随偏差跳闸阈值 [mm], 0=关闭保护]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          </Symbol>
          <Symbol CreateSymbol="true">
            <Name>LeadTimeMs</Name>
            <Comment TxtId=""><![CDATA[位置超前 τ [ms], 每拍限速0.05ms; 用60B1时保持0]]></Comment>
            <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          </Symbol>
        </DataArea>
