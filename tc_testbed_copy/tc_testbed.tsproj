									<Name>Driver_Modes_of_operation</Name>
									<BitSize>8</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000003}">SINT</BaseType>
									<BitOffs>24</BitOffs>
								</Symbol>
								<Symbol>
									<Name>Driver_Inertia_ratio</Name>
									<BitSize>16</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
									<BitOffs>32</BitOffs>
								</Symbol>
								<Symbol>
									<Name>Driver_Rigidity_level</Name>
									<BitSize>16</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
									<BitOffs>48</BitOffs>
								</Symbol>
								<Symbol CreateSymbol="true">
									<Name>Driver_SpdLoop_Kp</Name>
									<Comment TxtId=""><![CDATA[绝对位置清零命令 (P10-06 AbsEncRst, 0x200A:06): 写 1 = 请求一次清零, 模块取走后自动清 0。只在 Enable=0 且所有驱动轴都不在 OP 时执行; 运行中写只挂起等待停机。]]></Comment>
									<BitSize>16</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
									<BitOffs>64</BitOffs>
								</Symbol>
								<Symbol CreateSymbol="true">
									<Name>Driver_SpdLoop_Ti</Name>
									<Comment TxtId=""><![CDATA[位置清零状态回显: 0=空闲 1=执行中 2=成功 3=失败 4=已判定待停机]]></Comment>
									<BitSize>16</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
									<BitOffs>80</BitOffs>
								</Symbol>
								<Symbol CreateSymbol="true">
									<Name>ExperimentType</Name>
									<BitSize>16</BitSize>
									<BaseType GUID="{357956CC-D1A1-4576-B5A4-10FF5D8A9034}">ExperimentType_T</BaseType>
									<BitOffs>96</BitOffs>
								</Symbol>
								<Symbol CreateSymbol="true">
									<Name>SigFreq</Name>
									<Comment TxtId=""><![CDATA[扰动频率]]></Comment>
									<BitSize>32</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
									<BitOffs>112</BitOffs>
								</Symbol>
								<Symbol>
									<Name>SigAmp</Name>
									<Comment TxtId=""><![CDATA[扰动幅值: 速度波形 [rpm], 位置波形 [指令单位], 负载扫描回读 [% 负载额定], 只读]]></Comment>
									<BitSize>32</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
									<BitOffs>144</BitOffs>
								</Symbol>
